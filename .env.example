# auto: use a live provider when its token exists, otherwise use demo data
# demo: always use built-in fixtures
# live: require provider tokens and fail loudly when they are absent
API_MODE=auto
PORT=4100
NODE_ENV=development
TRUST_PROXY=false

# Optional MySQL/MariaDB storage from HestiaCP/phpMyAdmin.
# Without all five values favorites live in memory until restart.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spyservice
DB_USER=spyservice
DB_PASSWORD=change_me

# Meta Ad Library API
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
META_CHROMIUM_EXECUTABLE_PATH=

# TikTok Commercial Content API client access token
TIKTOK_ACCESS_TOKEN=
