# auto: use a live provider when its token exists, otherwise use demo data
# demo: always use built-in fixtures
# live: require provider tokens and fail loudly when they are absent
API_MODE=auto
PORT=4100
NODE_ENV=development
TRUST_PROXY=false

# Optional PostgreSQL storage. Without it favorites live in memory until restart.
DATABASE_URL=postgresql://spyservice:change_me@127.0.0.1:5432/spyservice

# Meta Ad Library API
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0

# TikTok Commercial Content API client access token
TIKTOK_ACCESS_TOKEN=
